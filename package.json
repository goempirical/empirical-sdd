{
  "name": "empirical-sdd",
  "version": "0.23.0",
  "description": "Agent-neutral, resumable spec-driven development for every terminal-capable coding agent",
  "type": "module",
  "bin": {
    "empirical": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "import": "./dist/integrations.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs/versioning.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 60000",
    "test:coverage": "bun test --timeout 60000 --coverage --coverage-reporter=lcov --coverage-reporter=text && bun run scripts/check-coverage.ts coverage/lcov.info",
    "test:dist": "bun run build && bun run scripts/smoke-mcp.ts",
    "prepack": "bun run build",
    "test:package": "bun run scripts/test-package.ts",
    "test:consistency": "bun run scripts/check-consistency.ts",
    "ci": "bun run check && bun run test && bun run test:coverage && bun run test:dist && bun run test:package && bun run test:consistency && git diff --check"
  },
  "keywords": [
    "agents",
    "mcp",
    "sdd",
    "spec-driven-development",
    "codex",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateoCerquetella/empirical-sdd.git"
  },
  "bugs": {
    "url": "https://github.com/MateoCerquetella/empirical-sdd/issues"
  },
  "homepage": "https://github.com/MateoCerquetella/empirical-sdd#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
